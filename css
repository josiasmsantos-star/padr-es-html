css
    body{
        font-family: arial, helvetica, sans-serif;
        background-color: #f4f4f4;
        margin: 20px;

    }

    #titulo{
        color:navy;
        text-align: center; 
    }

    .texto{
        color: #333;
        font-size: 18px;
    }

    button {
        background-color: green;
        color: white;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
    }

    button:hover {
        background-color: red;
    }

    .botoes {
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .caixa{
        background-color: white;
        border: 2px solid black;
        padding: 20px;
        margin: 20px;
        width: 300px;
        border-radius: 40px;
    }
    
